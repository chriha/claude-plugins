#!/usr/bin/env bash
#
# Deterministic, token-free preparation of an MR/PR for /tour:review.
# Usage:  tour-fetch <id|url> [--no-open]   (run inside a clone of the project; needs git, jq, gh or glab)
#   <id>   MR/PR number; the project comes from the `origin` remote.
#   <url>  https://<host>/<owner>/<repo>/pull/<n>  (GitHub)  or  https://<host>/<group>/<proj>/-/merge_requests/<n>  (GitLab)
# Platform: from the URL, else from the origin host (github.com → gh, anything else → glab); TOUR_PLATFORM=gh|glab overrides.
# Writes  ${CLAUDE_PLUGIN_DATA:-~/.claude/tour}/<host>/<project-path>/<iid>/<head-sha>/  (outside the repo):
#   meta.json (title, refs, shas, ticket, paths) · worktree/ (detached at the head SHA) · diff.patch · atoms.json
# Prints meta.json plus "cached" and "previous" on stdout. previous = {head_sha, dir} of the newest other head of this MR/PR that
# already has a tour.json (the base for tour-delta), else null. cached=true when tour.json already exists for that head SHA: then nothing
# is fetched from git and nothing is rewritten. --no-open is accepted for the caller (fetch never opens anything).
# Atoms: one per `git diff -U0` hunk (id a1, a2, … in diff order); a file without hunks (pure rename, binary,
# mode-only, empty add/delete) gets one atom with kind rename|binary|mode|add|delete, so every changed file is covered.
#
set -euo pipefail

die() { echo "tour-fetch: $*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is required"

arg="" no_open=false
while [ $# -gt 0 ]; do
    case "$1" in
        --no-open) no_open=true; shift ;;
        -*) die "unknown option $1" ;;
        *) [ -z "$arg" ] || die "usage: tour-fetch <id|url> [--no-open]"; arg="$1"; shift ;;
    esac
done
[ -n "$arg" ] || die "usage: tour-fetch <id|url> [--no-open]"

# --- platform, host, project, iid
platform="" host="" project="" iid=""
url="${arg%%[?#]*}"; url="${url%/}"
case "$url" in
    http*://*/pull/[0-9]*)
        rest="${url#*://}"; host="${rest%%/*}"; rest="${rest#*/}"
        project="${rest%%/pull/*}"; iid="${rest##*/pull/}"; iid="${iid%%/*}"; platform=gh ;;
    http*://*/merge_requests/[0-9]*)
        rest="${url#*://}"; host="${rest%%/*}"; rest="${rest#*/}"
        project="${rest%%/merge_requests/*}"; project="${project%/-}"
        iid="${rest##*/merge_requests/}"; iid="${iid%%/*}"; platform=glab ;;
    *[!0-9]*|"") die "not an MR/PR id or URL: $arg" ;;
    *)
        iid="$url"
        # raw config value on purpose: `git remote get-url` would expand url.<base>.insteadOf
        remote="$(git config --get remote.origin.url)" || die "no origin remote; pass a full URL"
        case "$remote" in
            *://*) rest="${remote#*://}"; rest="${rest#*@}"; host="${rest%%/*}"; project="${rest#*/}" ;;
            *@*:*) rest="${remote#*@}"; host="${rest%%:*}"; project="${rest#*:}" ;;
            *) die "cannot parse the origin remote: $remote" ;;
        esac
        host="${host%%:*}"; project="${project%.git}"; project="${project%/}"
        case "$host" in github.com) platform=gh ;; *) platform=glab ;; esac ;;
esac
platform="${TOUR_PLATFORM:-$platform}"
case "$platform" in gh|glab) ;; *) die "TOUR_PLATFORM must be gh or glab" ;; esac
[ -n "$host" ] && [ -n "$project" ] && [ -n "$iid" ] || die "could not work out host/project/id from $arg"
case "$iid" in *[!0-9]*) die "bad MR/PR number in $arg" ;; esac
case "$host/$project" in *..*|*[!A-Za-z0-9._/-]*) die "unsupported host or project path in $arg" ;; esac
command -v "$platform" >/dev/null || die "$platform is required"

# --- MR/PR metadata → one normalised object
case "$platform" in
    gh)
        raw="$(gh pr view "$iid" --repo "$host/$project" \
            --json number,title,body,url,baseRefName,headRefName,headRefOid,closingIssuesReferences)" || die "gh pr view failed"
        meta="$(printf '%s' "$raw" | jq -c --arg host "$host" --arg project "$project" '{
            platform: "github", host: $host, project: $project, iid: .number, title: .title, description: (.body // ""),
            url: .url, target_branch: .baseRefName, source_branch: .headRefName, head_sha: .headRefOid,
            ticket: ((.closingIssuesReferences // [])[0] // null | if . == null then null
                     else {id: ("#" + (.number | tostring)), summary: .title, text: (.body // "")} end)}')"
        headref="refs/pull/$iid/head" ;;
    glab)
        enc="$(printf '%s' "$project" | sed 's#/#%2F#g')"
        raw="$(GITLAB_HOST="$host" glab api "projects/$enc/merge_requests/$iid")" || die "glab api (merge request) failed"
        issues="$(GITLAB_HOST="$host" glab api "projects/$enc/merge_requests/$iid/closes_issues" 2>/dev/null || echo '[]')"
        printf '%s' "$issues" | jq -e 'type == "array"' >/dev/null 2>&1 || issues='[]'
        meta="$(printf '%s' "$raw" | jq -c --arg host "$host" --arg project "$project" --argjson issues "$issues" '{
            platform: "gitlab", host: $host, project: $project, iid: .iid, title: .title, description: (.description // ""),
            url: .web_url, target_branch: .target_branch, source_branch: .source_branch,
            head_sha: (.diff_refs.head_sha // .sha),
            ticket: ($issues[0] // null | if . == null then null
                     else {id: ("#" + (.iid | tostring)), summary: .title, text: (.description // "")} end)}')"
        headref="refs/merge-requests/$iid/head" ;;
esac
if [ "$platform" = gh ]; then # closingIssuesReferences carries only the number: read title and body from the issue
    tnum="$(printf '%s' "$meta" | jq -r '.ticket.id // empty | ltrimstr("#")')"
    if [ -n "$tnum" ]; then
        tk="$(gh issue view "$tnum" --repo "$host/$project" --json title,body 2>/dev/null)" || tk='{}'
        meta="$(printf '%s' "$meta" | jq -c --argjson t "$tk" '.ticket.summary = ($t.title // "") | .ticket.text = ($t.body // "")')"
    fi
fi
head_sha="$(printf '%s' "$meta" | jq -r '.head_sha // empty')"
printf '%s' "$head_sha" | grep -Eq '^[0-9a-f]{40,64}$' || die "no valid head sha in the $platform response"

dir="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/tour}/$host/$project/$iid/$head_sha"

previous() { # {head_sha, dir} of the newest other head with a tour.json, else null
    local t p="null"
    t="$(ls -t "${dir%/*}"/*/tour.json 2>/dev/null | grep -vxF "$dir/tour.json" | head -n 1 || true)"
    if [ -n "$t" ]; then p="$(jq -cn --arg d "${t%/tour.json}" '{head_sha: ($d | split("/") | last), dir: $d}')"; fi
    printf '%s' "$p"
}
emit() { # <meta json> <cached>
    printf '%s' "$1" | jq --argjson cached "$2" --argjson no_open "$no_open" --argjson previous "$(previous)" \
        '. + {cached: $cached, no_open: $no_open, previous: $previous}'
}

# --- cache hit: report it, touch nothing
if [ -f "$dir/tour.json" ]; then
    if [ -f "$dir/meta.json" ]; then base="$(cat "$dir/meta.json")"; else base="$(printf '%s' "$meta" | jq -c --arg d "$dir" '. + {dir: $d}')"; fi
    emit "$base" true
    exit 0
fi

# --- fetch the refs, detached worktree at the head SHA, diff against merge-base(target, head)
target="$(printf '%s' "$meta" | jq -r '.target_branch')"
git fetch -q origin "$target" || die "git fetch origin $target failed"
target_sha="$(git rev-parse --verify -q 'FETCH_HEAD^{commit}')" || die "cannot resolve $target"
git fetch -q origin "$headref" || die "git fetch origin $headref failed"
fetched="$(git rev-parse --verify -q 'FETCH_HEAD^{commit}')" || die "cannot resolve $headref"
[ "$fetched" = "$head_sha" ] || { echo "tour-fetch: ! fetched head $fetched differs from the API's $head_sha; using the fetched one" >&2; head_sha="$fetched"; dir="${dir%/*}/$head_sha"; }
mkdir -p "$dir"
wt="$dir/worktree"
if [ -d "$wt" ] && [ "$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)" = "$head_sha" ]; then :; else
    [ -d "$wt" ] && { git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; git worktree prune; }
    git worktree add -q --detach "$wt" "$head_sha"
fi
base_sha="$(git merge-base "$target_sha" "$head_sha")" || die "no merge base between $target and the head"

git -c core.quotepath=false diff -U0 -M --no-color --no-ext-diff --no-textconv --diff-algorithm=default \
    --src-prefix=a/ --dst-prefix=b/ "$base_sha" "$head_sha" > "$dir/diff.patch"

jq -Rn '
  # git C-quotes a path holding ", \ or a control character: "a/quo\"te", \t \n \\ \" and 3-digit octal bytes (octal is read as a code point: enough for control characters; invalid UTF-8 names are unsupported)
  def unq: if startswith("\"") and endswith("\"") and length >= 2 then
        .[1:-1] | gsub("\\\\(?<c>[0-7]{3}|.)"; .c as $c
            | if ($c | length) == 3 then [($c | explode | map(. - 48)) as $d | $d[0] * 64 + $d[1] * 8 + $d[2]] | implode
              else ({t: "\t", n: "\n", r: "\r", a: "\u0007", b: "\b", f: "\f", v: "\u000b"})[$c] // $c end)
      else . end;
  # the b/ path of a `diff --git` header: after a quoted "a/…" token, else a quoted "b/…" token, else the second of two equal-length plain paths
  def newfile($l): ($l | ltrimstr("diff --git ")) as $r
      | (if ($r | startswith("\"")) then ($r | capture("^\"(?:[^\"\\\\]|\\\\.)*\" (?<b>.*)$").b | unq)
         elif ($r | contains(" \"b/")) then ($r | split(" \"b/")[1:] | join(" \"b/") | "\"b/" + . | unq)
         else $r[((($r | length) + 1) / 2 | floor):] end)
        | ltrimstr("b/") | {path: ., old_file: ., status: "modified", binary: false, mode: null, hunks: []};
  def finish: if .cur == null then . else .files += [.cur] | .cur = null end;
  reduce inputs as $l ({files: [], cur: null, inhunk: false};
    if ($l | startswith("diff --git ")) then finish | .cur = newfile($l) | .inhunk = false
    elif $l | startswith("@@ ") then
        ($l | capture("^@@ -(?<os>[0-9]+)(,(?<oc>[0-9]+))? \\+(?<ns>[0-9]+)(,(?<nc>[0-9]+))? @@")) as $m
        | .inhunk = true
        | .cur.hunks += [{old: {start: ($m.os | tonumber), count: (if $m.oc == null then 1 else ($m.oc | tonumber) end)},
                          new: {start: ($m.ns | tonumber), count: (if $m.nc == null then 1 else ($m.nc | tonumber) end)}, lines: []}]
    elif .inhunk then .cur.hunks[-1].lines += [$l]
    elif $l | startswith("old mode ") then .cur.mode.old = ($l | ltrimstr("old mode "))
    elif $l | startswith("new mode ") then .cur.mode.new = ($l | ltrimstr("new mode "))
    elif $l | startswith("new file mode ") then .cur.status = "added"
    elif $l | startswith("deleted file mode ") then .cur.status = "deleted"
    elif $l | startswith("rename from ") then .cur.old_file = ($l | ltrimstr("rename from ") | unq) | .cur.status = "renamed"
    elif $l | startswith("rename to ") then .cur.path = ($l | ltrimstr("rename to ") | unq)
    elif ($l | startswith("Binary files ")) or ($l | startswith("GIT binary patch")) then .cur.binary = true
    else . end)
  | finish | .files
  | map(. as $f
      | if ($f.hunks | length) > 0 then
          $f.hunks | map({file: $f.path, old_file: $f.old_file, status: $f.status, kind: "hunk", old: .old, new: .new, lines: .lines, mode: $f.mode})
        else
          [{file: $f.path, old_file: $f.old_file, status: $f.status,
            kind: (if $f.binary then "binary" elif $f.status == "renamed" then "rename" elif $f.mode != null then "mode"
                   elif $f.status == "added" then "add" elif $f.status == "deleted" then "delete" else "mode" end),
            old: null, new: null, lines: [], mode: $f.mode}]
        end)
  | flatten | to_entries | map({id: ("a" + ((.key + 1) | tostring))} + .value)
' "$dir/diff.patch" > "$dir/atoms.json"

out="$(printf '%s' "$meta" | jq -c --arg dir "$dir" --arg wt "$wt" --arg tsha "$target_sha" --arg bsha "$base_sha" --arg hsha "$head_sha" \
    --slurpfile atoms "$dir/atoms.json" \
    '. + {head_sha: $hsha, target_sha: $tsha, base_sha: $bsha, dir: $dir, worktree: $wt, atoms_file: ($dir + "/atoms.json"), atom_count: ($atoms[0] | length)}')"
printf '%s\n' "$out" > "$dir/meta.json"
emit "$out" false
