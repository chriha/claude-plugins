#!/usr/bin/env python3
"""harness-credential-guard: PreToolUse hook that denies reading SSH and AWS credentials.

Wired in hooks/hooks.json for Bash|Monitor|Read|Grep|Glob. Like harness-guard it only checks harness-scoped calls (a `harness:*`
sub-agent, or a cwd / command text under `.user/worktrees/`); pass `--always` (wire it yourself in the project's
`.claude/settings.json` hooks) to check every call of every session. Reads a Claude Code hook payload on stdin and prints a
deny decision when the call would touch:
- the whole ~/.ssh directory,
- ~/.aws/credentials, ~/.aws/sso and ~/.aws/cli/cache.
Read, Grep and Glob are checked on path, glob and cwd with real paths (`..`, symlinks and `~` resolved, and a search
from a parent directory such as ~ counts). Bash is checked on the command text only.

Deny only, no output redaction. Best effort: a Bash command string can be disguised (variables, base64, scripts); the real
containment is not having these credentials readable by the agent's user. Known gap: a Bash search rooted at ~ (grep -r ~,
find ~) is not caught; the Grep/Glob tools are, and so is a bare `.*` component from a home cwd (`cat .*/id_rsa`). Only Bash,
Monitor, Read, Grep and Glob are hooked. A crash inside the check or an unparseable payload is denied; a missing python3 or a
hook timeout is not (the hook's onFailure setting decides). HARNESS_CREDENTIAL_GUARD_HOME overrides the home directory (tests).
Ported from a project-local guard; behaviour is covered by tests/run.sh.
"""

import fnmatch
import json
import os
import re
import sys

PROTECTED = [".ssh", ".aws/credentials", ".aws/sso", ".aws/cli/cache"]

BASH_DENY = [
    (r"\.ssh(?![\w.-])", "~/.ssh is off-limits"),
    (r"\.aws/(credentials|sso|cli)\b", "AWS credentials are off-limits"),
    (r"\.aws(?:/(?![\w.-])|(?![\w./-]))","~/.aws is off-limits (a cd into it would expose credentials)"),
    (
        r"(?:~|\$\{?HOME\}?|/(?:Users|home)/[^/\s]+|/root)/\.(s[\w]{0,2}|a[\w]{0,2})?[*?\[{]",
        "wildcards that could expand to ~/.ssh or ~/.aws are off-limits",
    ),
    (
        r"(?:^|[\s;&|\"'=(])\.(s\w{0,2}|a\w{0,2})[*?\[{]",
        "wildcards that could expand to ~/.ssh or ~/.aws are off-limits",
    ),
    (r"\.aws/(\./)+|\.aws/[\w.-]*[*?\[{]", "AWS credentials are off-limits"),
    (r"\bconfigure\s+export-credentials\b", "exporting AWS credentials is off-limits"),
    (r"\bconfigure\s+get\b[^|;&\n]*\baws_(secret_access_key|session_token)\b", "exporting AWS credentials is off-limits"),
]

GLOB_DENY = r"\.ssh(?![\w.-])|\.aws/(credentials|sso|cli)\b"

REASON = "SSH and AWS credentials are off-limits"


def home():
    return os.environ.get("HARNESS_CREDENTIAL_GUARD_HOME") or os.path.expanduser("~")


def collapse_slashes(path):
    return "/" + path.lstrip("/") if path.startswith("/") else path


def expand_braces(pattern, limit=64):
    """Expand `{a,b}` alternatives (a single `{s}` too), as the Glob tool does; bounded so a hostile pattern stays cheap."""
    match = re.search(r"\{([^{}]*)\}", pattern)
    if not match or limit <= 1:
        return [pattern]
    out = []
    for alt in match.group(1).split(","):
        out += expand_braces(pattern[: match.start()] + alt + pattern[match.end() :], limit // 2)
    return out


def real(path, cwd):
    if path == "~" or path.startswith("~/"):
        path = home() + path[1:]
    path = collapse_slashes(path)
    return os.path.realpath(os.path.join(cwd, path)).lower()


def touches_protected(path, cwd):
    """True when the path is inside a protected path or a directory that contains one (a search from there would cover it)."""
    target = real(path, cwd)
    if re.search(GLOB_DENY, target, re.I):
        return True
    for protected in PROTECTED:
        protected = real(os.path.join(home(), protected), "/")
        if os.path.commonpath([target, protected]) in (target, protected):
            return True
    return False


def glob_denied(pattern, base):
    """base is the directory a relative pattern is searched from (the tool's path, else the cwd)."""
    if not pattern:
        return False
    return any(glob_denied_one(p, base) for p in expand_braces(str(pattern)))


def glob_denied_one(pattern, base):
    if re.search(GLOB_DENY, pattern, re.I):
        return True
    literal = re.split(r"[*?\[{]", pattern, maxsplit=1)[0]
    if literal != "" and touches_protected(literal, base):
        return True
    return matches_protected_components(pattern, base)


def matches_protected_components(pattern, base):
    """A wildcard inside a path component (`~/.s*/id_*`) can expand to a protected path; match component-wise."""
    if pattern == "~" or pattern.startswith("~/"):
        pattern = home() + pattern[1:]
    parts = os.path.normpath(os.path.join(base, collapse_slashes(pattern))).lower().split("/")
    for protected in PROTECTED:
        wanted = real(os.path.join(home(), protected), "/").split("/")
        if len(parts) >= len(wanted) and all(fnmatch.fnmatchcase(w, p) for w, p in zip(wanted, parts)):
            return True
    return False


def deny_reason(tool, tool_input, cwd):
    if tool in ("Bash", "Monitor"):
        command = str(tool_input.get("command", ""))
        for pattern, reason in BASH_DENY:
            if re.search(pattern, command, re.I):
                return reason
        return None
    if tool not in ("Read", "Grep", "Glob"):
        return None
    path = tool_input.get("file_path") if tool == "Read" else tool_input.get("path") or cwd
    if path and touches_protected(str(path), cwd):
        return REASON
    pattern = tool_input.get("pattern") if tool == "Glob" else tool_input.get("glob")
    if glob_denied(pattern, real_base(path, cwd)):
        return REASON
    return None


def real_base(path, cwd):
    return real(str(path), cwd) if path else cwd


WT = "/.user/worktrees/"


def in_scope(payload):
    """Harness agents, or anything running in/at a harness worktree."""
    if str(payload.get("agent_type") or "").startswith("harness:"):
        return True
    tool_input = payload.get("tool_input") or {}
    where = [str(payload.get("cwd") or ""), str(tool_input.get("command") or ""), str(tool_input.get("file_path") or ""),
             str(tool_input.get("path") or "")]
    return any(WT in w for w in where)


def main():
    always = "--always" in sys.argv[1:]
    try:
        payload = json.load(sys.stdin)
        if not always and not in_scope(payload):
            return 0
        reason = deny_reason(payload.get("tool_name"), payload.get("tool_input") or {}, payload.get("cwd") or os.getcwd())
    except Exception:
        reason = "the guard could not parse this call"
    if reason is not None:
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": f"harness-credential-guard: {reason}. Ask the user to run it themselves.",
                }
            },
            sys.stdout,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
